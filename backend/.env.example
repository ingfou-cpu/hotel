# ---------------------------------------------------------------------------
# Modèle de configuration — copier vers .env puis remplir les valeurs
# ---------------------------------------------------------------------------
# Clé secrète Django : générer avec
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL en production :
# DATABASE_URL=postgres://UTILISATEUR:MOT_DE_PASSE@HOTE:5432/NOM_DE_LA_BASE
# (si absent : base SQLite dans backend/db.sqlite3)
# DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_ALL_ORIGINS=False

# Emails : console en développement, SMTP en production
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@exemple.com

# Celery / Redis (file de tâches)
REDIS_URL=redis://localhost:6379/0
# Exécution synchrone des tâches sans worker (dev/tests). false en production.
CELERY_TASK_ALWAYS_EAGER=false

# Nom du site (emails, notifications)
SITE_NAME=HotelBooking
# Délai avant expiration d'un paiement en attente (secondes)
PAYMENT_PENDING_TIMEOUT_SECONDS=3600

# Stripe (clés du dashboard Stripe)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Obtenir le secret de test : stripe listen --forward-to http://localhost:8000/api/v1/payments/webhook/
# Puis tester avec : stripe trigger payment_intent.succeeded
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur

# Règles métier des réservations
BOOKING_TAX_RATE=0.10
BOOKING_SERVICE_FEE=5.0
BOOKING_CANCELLATION_DEADLINE_DAYS=2

FRONTEND_URL=http://localhost:5173